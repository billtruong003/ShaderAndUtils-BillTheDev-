#pragma kernel CSMain

struct ManagedAgent
{
    // Dữ liệu không thay đổi bởi shader này
    float3 transformPosition; // Sử dụng để đồng bộ lại nếu cần, hoặc để trống
    uint clipInfoPtr; // Có thể dùng để trỏ tới thông tin clip nếu cần
    
    // Dữ liệu sẽ được cập nhật
    float currentTimeSeconds;
    float previousTimeSeconds;
    float crossFadeTimer;
    
    // Dữ liệu điều khiển
    float currentClipDuration;
    uint currentClipWrapMode; // 0: Once, 1: Loop, 2: PingPong
    float previousClipDuration;
    uint previousClipWrapMode;
    float crossFadeDuration;
    uint isBlending; // Dùng uint thay cho bool
};

RWStructuredBuffer<ManagedAgent> _AgentsBuffer;
float _DeltaTime;
uint _MaxAgents;

[numthreads(64,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _MaxAgents)
    {
        return;
    }
    
    ManagedAgent agent = _AgentsBuffer[id.x];

    agent.currentTimeSeconds += _DeltaTime;
    if (agent.currentClipDuration > 0.0)
    {
        if (agent.currentClipWrapMode == 1) // Loop
        {
            agent.currentTimeSeconds = fmod(agent.currentTimeSeconds, agent.currentClipDuration);
        }
    }
    
    if (agent.isBlending == 1)
    {
        agent.crossFadeTimer += _DeltaTime;
        if (agent.crossFadeTimer >= agent.crossFadeDuration)
        {
            agent.isBlending = 0;
        }
        
        if (agent.previousClipDuration > 0.0)
        {
            agent.previousTimeSeconds += _DeltaTime;
            if (agent.previousClipWrapMode == 1) // Loop
            {
                agent.previousTimeSeconds = fmod(agent.previousTimeSeconds, agent.previousClipDuration);
            }
        }
    }

    _AgentsBuffer[id.x] = agent;
}